# Shared secret that n8n sends as the X-API-Key header.
# Generate with: openssl rand -hex 24
API_KEY=change-me

# SQLite location. On Railway this must sit on the mounted volume.
STORE_PATH=/data/market_intel.db

# Story clustering
CLUSTER_WINDOW_HOURS=72
SIMHASH_BLOCK_DISTANCE=22
JACCARD_THRESHOLD=0.45

# Housekeeping
RETENTION_DAYS=30
LOG_LEVEL=INFO
